# Use Aiven's connection pooling port (usually direct_port + 1) for better performance
# e.g. if direct port is 20559, pooling port is typically 20560
DATABASE_URL=postgresql://USER:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require&connection_limit=5&pool_timeout=10
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Paystack
PAYSTACK_SECRET_KEY=sk_live_REPLACE_ME
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_REPLACE_ME
PAYSTACK_HATCHLING_MONTHLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_HATCHLING_QUARTERLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_HATCHLING_ANNUAL_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_DRAKE_MONTHLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_DRAKE_QUARTERLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_DRAKE_ANNUAL_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_ELDER_DRAGON_MONTHLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_ELDER_DRAGON_QUARTERLY_PLAN_CODE=PLN_REPLACE_ME
PAYSTACK_ELDER_DRAGON_ANNUAL_PLAN_CODE=PLN_REPLACE_ME
LATE_API_KEY=REPLACE_ME
LATE_WEBHOOK_SECRET=REPLACE_ME
# Shared Zernio profile ID — all TikTokAccount rows reuse this to avoid the Free-plan 2-profile limit
LATE_PROFILE_ID=REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
# Direct connection for Prisma migrations (bypasses connection pooler)
DIRECT_URL=postgresql://USER:PASSWORD@db.HOST.supabase.co:5432/postgres?sslmode=require

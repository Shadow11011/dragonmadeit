# Use Aiven's connection pooling port (usually direct_port + 1) for better performance
# e.g. if direct port is 20559, pooling port is typically 20560
DATABASE_URL=postgresql://USER:PASSWORD@HOST.aivencloud.com:PORT/defaultdb?sslmode=require&connection_limit=5&pool_timeout=10
NEXTAUTH_SECRET=replace-with-openssl-rand-base64-32
NEXTAUTH_URL=http://localhost:3000
# Dodo Payments
DODO_API_KEY=dodo_test_REPLACE_ME
DODO_WEBHOOK_SECRET=whsec_REPLACE_ME
# "test" for test-mode; "live" for live-mode.
DODO_ENV=test
# Dodo product IDs — 5 self-serve paid tiers x 3 billing intervals.
# AGENCY is custom-billed and has no self-serve product.
DODO_SCHEDULER_MONTHLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_SCHEDULER_QUARTERLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_SCHEDULER_ANNUAL_PRODUCT_ID=pdt_REPLACE_ME
DODO_CREATOR_MONTHLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_CREATOR_QUARTERLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_CREATOR_ANNUAL_PRODUCT_ID=pdt_REPLACE_ME
DODO_CLIPPER_MONTHLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_CLIPPER_QUARTERLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_CLIPPER_ANNUAL_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_MONTHLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_QUARTERLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_ANNUAL_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_PRO_MONTHLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_PRO_QUARTERLY_PRODUCT_ID=pdt_REPLACE_ME
DODO_STUDIO_PRO_ANNUAL_PRODUCT_ID=pdt_REPLACE_ME
LATE_API_KEY=REPLACE_ME
LATE_WEBHOOK_SECRET=REPLACE_ME
# Shared Zernio profile ID — all TikTokAccount rows reuse this to avoid the Free-plan 2-profile limit
LATE_PROFILE_ID=REPLACE_ME
RESEND_API_KEY=re_REPLACE_ME
# Direct connection for Prisma migrations (bypasses connection pooler)
DIRECT_URL=postgresql://USER:PASSWORD@db.HOST.supabase.co:5432/postgres?sslmode=require

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Tier {
  FREE
  SCHEDULER
  CREATOR
  CLIPPER
  STUDIO
  STUDIO_PRO
  AGENCY
}

enum ContentStatus {
  DRAFT
  SCHEDULED
  PROCESSING
  POSTED
  FAILED
}

enum VideoType {
  GAMEPLAY
  AI_IMAGES
}

enum VoiceType {
  MALE
  FEMALE
  RANDOM
}

enum VideoSource {
  GENERATED
  UPLOADED
}

enum BillingInterval {
  MONTHLY
  QUARTERLY
  ANNUAL
}

model User {
  id                      String          @id @default(cuid())
  email                   String          @unique
  name                    String?
  image                   String?
  hashedPassword          String?
  emailVerified           DateTime?
  // Dodo Payments customer ID. Dodo's checkout lazily creates a customer on
  // first payment; we persist the returned ID on `subscription.active` so
  // subsequent checkouts can reuse the same Dodo customer record.
  dodoCustomerId          String?
  onboardingComplete      Boolean         @default(false)
  // Referral program (Task 1.10)
  // `referralCode` is an 8-char opaque slug every user owns; backfilled for
  // all existing users in migration `add_referral_program`. New users get one
  // assigned in code at User create time (see src/lib/referral.ts).
  // `referredByUserId` is set at signup if ?ref=<code> captured a valid code.
  // `referralCredits` is stored in cents (1000 = $10). One-time credits apply
  // on the referrer's next charge.
  // `referralCreditAppliedAt` is an idempotency flag on the REFERRED user so
  // the Dodo webhook never double-credits on retried deliveries.
  referralCode            String          @unique
  referredByUserId        String?
  referralCredits         Int             @default(0)
  referralCreditAppliedAt DateTime?
  tiktokAccounts          TikTokAccount[]
  contentItems            ContentItem[]
  accounts                Account[]
  sessions                Session[]
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([referredByUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// Device fingerprint log for abuse control on the FREE tier.
// One row per free-account activation. We index clientHash so duplicate-device
// checks are O(1). ipHash/uaHash are soft signals, logged but not unique.
model DeviceFingerprint {
  id         String   @id @default(cuid())
  clientHash String // SHA-256 from browser signals (canvas/webgl/screen/etc.)
  ipHash     String // SHA-256 of the request IP (salted)
  uaHash     String // SHA-256 of UA + accept-language + sec-ch-ua
  tier       Tier
  userId     String
  accountId  String? // optional: TikTokAccount.id this fingerprint activated
  createdAt  DateTime @default(now())

  @@index([clientHash])
  @@index([ipHash])
  @@index([userId])
}

model TikTokAccount {
  id                 String          @id @default(cuid())
  username           String
  displayName        String?
  accessToken        String?
  refreshToken       String?
  tier               Tier            @default(FREE)
  billingInterval    BillingInterval @default(MONTHLY)
  // Dodo Payments subscription ID. Populated by the `subscription.active`
  // webhook; cleared on `subscription.cancelled`. Unique so the webhook
  // handler can dedupe by ID cheaply.
  dodoSubscriptionId String?         @unique
  videosPerWeek      Int             @default(0)
  schedule           Json?
  scheduleLocked     Boolean         @default(false)
  videoType          VideoType       @default(GAMEPLAY)
  voiceType          VoiceType       @default(RANDOM)
  storyTypes         Json            @default("[]")
  randomizeStories   Boolean         @default(true)
  lateProfileId      String?
  lateAccountId      String?
  // n8n pipeline coordination
  nextPostAt         DateTime?
  videoGenStatus     String          @default("IDLE")
  // Routing flag: 'v1' = legacy orchestrator (mt5BR1Jn3F4oFpON), 'v2' = hardened
  // pipeline (n8n/workflows/v2/orchestrator-v2.json). Default is v1; rows are
  // flipped to v2 one-by-one as the new pipeline proves out per-account.
  pipelineVersion    String          @default("v1")
  // Timestamp of last GENERATING transition. Used by the v2 reaper to detect
  // jobs stuck >20min and reset them back to IDLE.
  videoGenStartedAt  DateTime?
  pendingVideoUrl    String?
  lastPostedAt       DateTime?
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  contentItems       ContentItem[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([pipelineVersion, videoGenStatus, nextPostAt])
}

model EmailVerificationCode {
  id                  String    @id @default(cuid())
  email               String
  codeHash            String
  type                String // "SIGNUP" | "PASSWORD_RESET"
  attempts            Int       @default(0)
  expiresAt           DateTime
  usedAt              DateTime?
  pendingName         String?
  pendingPasswordHash String?
  createdAt           DateTime  @default(now())

  @@index([email, type])
}

model ContentItem {
  id              String         @id @default(cuid())
  title           String
  description     String?
  videoUrl        String?
  thumbnailUrl    String?
  status          ContentStatus  @default(DRAFT)
  source          VideoSource    @default(GENERATED)
  scheduledAt     DateTime?
  postedAt        DateTime?
  tiktokPostId    String?        @unique
  userId          String
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  tiktokAccountId String?
  tiktokAccount   TikTokAccount? @relation(fields: [tiktokAccountId], references: [id])
  errorMessage    String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}
